# Backend (Express payment API) environment variables
# Copy to .env and fill in real values

PORT=3000

# Razorpay (rotate if compromised — never commit this file)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# CORS: your frontend URL
FRONTEND_URL=http://localhost:5173

# Supabase (service role — SERVER ONLY, never expose to browser)
# Used in Phase 4 for server-side order persistence
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Logging level: debug | info | warn | error
LOG_LEVEL=info