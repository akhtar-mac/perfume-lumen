# ============================================
# LUMEN Frontend Environment Variables
# Fill in your values and rename to .env
# ============================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Razorpay Payment Gateway
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
VITE_RAZORPAY_KEY_SECRET=your-razorpay-secret

# Backend API URL (Render/Railway/etc)
VITE_API_URL=https://your-backend.onrender.com

# Site Configuration
VITE_SITE_URL=https://lumenperfumes.com
VITE_SITE_NAME=LUMEN Perfumes

# WhatsApp Number (for chat widget, without +)
VITE_WHATSAPP_NUMBER=917567583505

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# reCAPTCHA (optional)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
