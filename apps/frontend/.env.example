# Frontend (customer storefront) environment variables
# Copy to .env.local and fill in real values

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:xxxx:web:xxxx

# Backend API URL — REQUIRED in production. Without this checkout breaks.
# Local dev falls back to http://localhost:3000 automatically.
VITE_API_URL=https://api.lumenperfumes.com

VITE_RAZORPAY_KEY_ID=rzp_test_xxxx